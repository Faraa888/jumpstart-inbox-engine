# Copy to .env (never commit .env)
# Send automatic replies after N minutes instead of 5 to 30 (use 1 when filming)
DEMO_DELAY=1
# Use Claude as the reviewer agent. Remove this line to use the offline rule checks.
REVIEWER=claude
ANTHROPIC_API_KEY=
# Stage given to senders the engine doesn't know (the demo pretends you're mid-interviews)
DEMO_STAGE=Interviewing
